{
  "manifest_version": 3,
  "name": "Custom New Tab",
  "version": "1.1.0",
  "description": "A lightweight, fast, dark-themed new tab dashboard with bookmarks and notes",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "homepage.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}