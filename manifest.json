{
  "manifest_version": 3,
  "name": "Custom New Tab",
  "version": "1.0.0",
  "description": "A minimal dark-themed homepage with search and bookmarks",
  "permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "homepage.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}